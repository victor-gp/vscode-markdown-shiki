{
  "name": "markdown-shiki",
  "version": "0.1.1",
  "displayName": "Markdown Preview VS Code Highlighting",
  "description": "Use VS Code's highlighter for code blocks in the built-in markdown preview.",
  "icon": "resources/logo.png",
  "keywords": [
    "markdown",
    "highlighting",
    "preview",
    "shiki",
    "code",
    "code block"
  ],
  "publisher": "bierner",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/mjbvz/vscode-markdown-shiki.git"
  },
  "bugs": {
    "url": "https://github.com/mjbvz/vscode-markdown-shiki/issues"
  },
  "engines": {
    "vscode": "^1.38.0"
  },
  "activationEvents": [],
  "main": "./index.js",
  "categories": [
    "Other"
  ],
  "contributes": {
    "markdown.markdownItPlugins": true,
    "configuration": {
      "title": "Markdown Shiki",
      "properties": {
        "markdownShiki.theme": {
          "markdownDescription": "Shiki theme to use in the markdown Preview. When set to `null` - uses active color theme.",
          "scope": "window",
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "abyss",
            "dark-plus",
            "dracula",
            "dracula-soft",
            "github-dark",
            "github-dark-default",
            "github-dark-dimmed",
            "github-light",
            "github-light-default",
            "hc-black",
            "hc-light",
            "light-plus",
            "material-theme",
            "material-theme-darker",
            "material-theme-lighter",
            "material-theme-ocean",
            "material-theme-palenight",
            "min-dark",
            "min-light",
            "monokai",
            "night-owl",
            "nord",
            "one-dark-pro",
            "one-light",
            "red",
            "rose-pine",
            "rose-pine-dawn",
            "rose-pine-moon",
            "solarized-dark",
            "solarized-light",
            "tokyo-night",
            "vitesse-dark",
            "vitesse-light"
          ],
          "default": null
        }
      }
    }
  },
  "dependencies": {
    "shiki": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^11.9.4",
    "@types/vscode": "^1.38"
  },
  "scripts": {}
}
